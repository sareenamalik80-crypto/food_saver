<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFoodPhoto"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="@color/cream_light"
                android:contentDescription="Food photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFoodTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNgoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/brown_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Accept / Reject — visible only while pending -->
        <LinearLayout
            android:id="@+id/actionsPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/cream_light"
                android:text="Reject"
                android:textColor="@color/error_red" />

            <Button
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/brown_primary"
                android:text="Accept"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Delivery info — visible once NGO fills it in, after acceptance -->
        <LinearLayout
            android:id="@+id/deliveryInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/cream_light"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Details"
                android:textColor="@color/brown_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tvRiderName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="12sp" />
            <TextView android:id="@+id/tvVehicleNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="12sp" />
            <TextView android:id="@+id/tvRiderPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="12sp" />
            <TextView android:id="@+id/tvArrivalTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="12sp" />
        </LinearLayout>

        <!-- Chat — visible once accepted -->
        <Button
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cream_light"
            android:text="Chat with NGO"
            android:textColor="@color/brown_primary"
            android:visibility="gone" />

        <!-- Dual-confirmation handover: donor's own confirmation button,
             visible once accepted and until the donor has pressed it. -->
        <Button
            android:id="@+id/btnMarkHandedOver"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_cta"
            android:text="Mark as Handed Over"
            android:textColor="@color/white"
            android:visibility="gone" />

        <!-- Shows once the donor has confirmed: either waiting on the NGO,
             or fully complete once both sides have confirmed. -->
        <TextView
            android:id="@+id/tvHandoverNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
