<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Admin">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".admin.dashboard.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.dashboard.AdminLoginActivity"
            android:exported="false" />

        <activity
            android:name=".admin.dashboard.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".admin.dashboard.AdminProfileActivity"
            android:exported="false" />

        <activity
            android:name=".admin.approvals.ApprovalsActivity"
            android:exported="false" />

        <activity
            android:name=".admin.approvals.AccountDetailActivity"
            android:exported="false" />

        <activity
            android:name=".admin.violations.PolicyViolationsActivity"
            android:exported="false" />

        <activity
            android:name=".admin.monitoring.DonationMonitoringActivity"
            android:exported="false" />

        <activity
            android:name=".admin.users.UserManagementActivity"
            android:exported="false" />

    </application>

</manifest>